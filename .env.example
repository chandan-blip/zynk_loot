# Server
NODE_ENV=production
PORT=5000 

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loot_db
DB_USER=loot_user
DB_PASSWORD=your_password

# Auth
JWT_SECRET=your_jwt_secret

# 2Factor.in API key (for phone OTP during registration)
# Sign up at https://2factor.in -> Dashboard -> API Key
# Free tier: 100 SMS/day for Indian numbers.
TWOFACTOR_API_KEY=

# Frontend (VITE_ prefix required for client-side access)
VITE_API_URL=/api

# Application domain (used by Website module for sub-domain publishing)
# Requires a wildcard DNS record (A *.yourdomain.com -> server IP) and
# a wildcard SSL cert for *.yourdomain.com.
APP_DOMAIN=yourdomain.com
VITE_APP_DOMAIN=yourdomain.com

# Allowed CORS origins (comma-separated). Include wildcard subdomains if needed.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Telegram bot + channel for the daily winners broadcast / prediction posts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WINNERS_CHANNEL_ID=
TELEGRAM_DASH_CHANNEL_ID=

# Shared secret for the Telegram webhook (channel-post -> SMM order). Must
# match the secret_token passed to setWebhook. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Payment Gateway bridge (OkPay). ONE OkPay merchant account fronts every client
# domain registered in Admin -> Payment Gateway. Register a single callback URL
# at OkPay: https://<your-domain>/api/gateway/okpay/callback
OKPAY_MERCHANT_ID=
OKPAY_MERCHANT_TOKEN=
# Public base URL of THIS server, used to build the callback_url handed to OkPay.
# Falls back to the incoming request host if unset.
GATEWAY_PUBLIC_URL=https://yourdomain.com
